<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="460"
        android:interpolator="@interpolator/spring" />
    <translate android:fromYDelta="4%" android:toYDelta="0" android:duration="460"
        android:interpolator="@interpolator/spring" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220"
        android:interpolator="@android:interpolator/decelerate_cubic" />
</set>
